# ---------------------------------------------------------------------------
# FDR SENTINEL — environment template
# Copy to `.env` and adjust values. NEVER commit real secrets.
# All values below are placeholders.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME=FDR Sentinel
APP_ENV=development            # development | production | test
DEBUG=true
API_PREFIX=/api/v1
# Timezone used for maturity checks, notifications and escalation calculations.
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---------------------------------------------------------------
# Local demo default (no external service required):
DATABASE_URL=sqlite:///./fdr_sentinel.db
# Production example (PostgreSQL / Supabase) — requires psycopg2 (installed):
#   Direct:    postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
#   Pooler:    postgresql://postgres.PROJECT:PASSWORD@aws-0-XX.pooler.supabase.co:6543/postgres?sslmode=require
#   (Use the Pooler (port 6543) for serverless/hosted backends like Vercel.)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Enable during first-time migration against an empty PostgreSQL database:
# RUN_DB_CREATE=false

# --- Authentication ---------------------------------------------------------
# Local JWT-based auth works out of the box for the demo (no external service).
AUTH_PROVIDER=local
JWT_SECRET=CHANGE-ME-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- File storage -----------------------------------------------------------
# Private directory for uploaded documents (never served statically).
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg

# --- OCR --------------------------------------------------------------------
# OCR_ENGINE=auto            # auto | tesseract | none
# OCR_LANGUAGES=eng
# Requires the Tesseract binary on PATH. When unavailable, scanned documents
# are marked "manual review required" instead of failing the application.
OCR_ENGINE=auto
OCR_LANGUAGES=eng
MIN_EMBEDDED_TEXT_CHARS=20   # below this a PDF is treated as scanned

# --- Email (OPTIONAL) -------------------------------------------------------
# If SMTP is not configured, notifications still appear in the in-app
# notification centre and are reported honestly as "in-app only".
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE-ME
SMTP_PASSWORD=CHANGE-ME
SMTP_FROM=fdr-sentinel@example.com
SMTP_USE_TLS=true

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
MATURITY_CHECK_INTERVAL_MINUTES=360
RUN_JOBS_ON_STARTUP=true

# --- Frontend (Vite) --------------------------------------------------------
# Origin of the backend API only (the client appends /api/v1 itself).
# Local dev: leave unset — the Vite dev server proxies /api to 127.0.0.1:8000.
# On Vercel: set to your deployed backend origin, e.g. https://fdr-sentinel-api.vercel.app
#            and add the frontend URL to the backend's CORS_ORIGINS.
# VITE_API_BASE=
