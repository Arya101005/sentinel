# ---- Browser-safe (exposed in the client bundle by design) -------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# ---- Server-only (Vercel Functions / Node scripts) --------------------------
# Never prefix these with VITE_ and never commit real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Optional: only needed for running the SQL migration script.
# Use the connection pooler host (IPv4). Never commit the real value.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:REPLACE_ME@aws-0-REGION.pooler.supabase.com:6543/postgres
# Shared secret for the scheduled maturity scan endpoint.
CRON_SECRET=REPLACE_ME
