    "lucide-react": "^0.446.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "tesseract.js": "^5.1.1",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
